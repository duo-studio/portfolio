{
	"name": "eleventy-base-blog",
	"version": "8.0.0",
	"description": "A starter repository for a blog web site using the Eleventy site generator.",
	"scripts": {
		"build:assets": "node scripts/build-assets.js",
		"prebuild": "npm run build:assets",
		"build": "cross-env ELEVENTY_ENV=production npx @11ty/eleventy",
		"prebuild-ghpages": "npm run build:assets",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/eleventy-base-blog/",
		"predev": "npm run build:assets",
		"dev": "cross-env ELEVENTY_ENV=development npx @11ty/eleventy --serve --quiet",
		"debug": "DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
		"videos:thumbnails": "node scripts/compress-videos.js --thumbnails",
		"videos:banners": "node scripts/compress-videos.js --banners",
		"videos:all": "node scripts/compress-videos.js --thumbnails --banners"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/11ty/eleventy-base-blog.git"
	},
	"author": {
		"name": "Zach Leatherman",
		"email": "zachleatherman@gmail.com",
		"url": "https://zachleat.com/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=14"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/11ty"
	},
	"bugs": {
		"url": "https://github.com/11ty/eleventy-base-blog/issues"
	},
	"homepage": "https://github.com/11ty/eleventy-base-blog#readme",
	"devDependencies": {
		"@11ty/eleventy": "^2.0.1",
		"@11ty/eleventy-img": "^3.1.0",
		"@11ty/eleventy-navigation": "^0.3.5",
		"@11ty/eleventy-plugin-bundle": "^1.0.4",
		"@11ty/eleventy-plugin-rss": "^1.2.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
		"@ffmpeg-installer/ffmpeg": "^1.1.0",
		"@quasibit/eleventy-plugin-schema": "^1.11.0",
		"cross-env": "^7.0.3",
		"esbuild": "^0.25.3",
		"fluent-ffmpeg": "^2.1.3",
		"luxon": "^3.3.0",
		"markdown-it-anchor": "^8.6.7",
		"markdown-it-attrs": "^4.1.6",
		"npm-run-all": "^4.1.5",
		"sass": "^1.63.6"
	}
}
