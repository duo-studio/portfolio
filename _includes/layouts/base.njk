---
type: page
meta:
  language: en-US
eleventyComputed:
    title: "{{ title or metadata.title }}"
    description: "{{ description or metadata.description }}"
---

<!DOCTYPE html>
<html lang="{{ metadata.language }}">
    <head>
        <script>
            (function (w, d, s, l, i) {
                var consentKey = "duo_analytics_consent_v1";
                var productionHost = /^(www\.)?duo-studio\.co$/i.test(w.location.hostname);
                var storedConsent = "";

                try {
                    storedConsent = w.localStorage.getItem(consentKey) || "";
                } catch (_error) {}

                w[l] = w[l] || [];
                w.gtag = w.gtag || function () {
                    w[l].push(arguments);
                };
                w.__duoAnalyticsProductionHost = productionHost;
                w.__duoAnalyticsConsent = storedConsent;

                function consentState(choice) {
                    var granted = choice === "granted";
                    return {
                        analytics_storage: granted ? "granted" : "denied",
                        ad_storage: granted ? "granted" : "denied",
                        ad_user_data: granted ? "granted" : "denied",
                        ad_personalization: granted ? "granted" : "denied",
                    };
                }

                w.gtag("consent", "default", Object.assign(
                    { wait_for_update: 500 },
                    consentState(storedConsent),
                ));
                w.gtag("set", "ads_data_redaction", true);
                w.gtag("set", "url_passthrough", false);

                w.duoSetAnalyticsConsent = function (choice) {
                    var normalizedChoice = choice === "granted" ? "granted" : "denied";
                    w.__duoAnalyticsConsent = normalizedChoice;

                    try {
                        w.localStorage.setItem(consentKey, normalizedChoice);
                    } catch (_error) {}

                    w.gtag("consent", "update", consentState(normalizedChoice));

                    var banner = d.querySelector("[data-analytics-consent]");
                    if (banner) {
                        banner.hidden = true;
                    }
                };

                w.duoShowAnalyticsConsent = function () {
                    var banner = d.querySelector("[data-analytics-consent]");
                    if (banner && productionHost) {
                        banner.hidden = false;
                    }
                };

                if (!productionHost) {
                    return;
                }

                w[l].push({"gtm.start": new Date().getTime(), event: "gtm.js"});
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer"
                        ? "&l=" + l
                        : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-WZC2NB5");
        </script>
        <script>
            window.duoPushEvent = function (eventName, params) {
                window.dataLayer = window.dataLayer || [];

                var payload = { event: eventName };
                var source = params || {};

                Object.keys(source).forEach(function (key) {
                    var value = source[key];
                    if (value !== undefined && value !== null && value !== "") {
                        payload[key] = value;
                    }
                });

                window.dataLayer.push(payload);
            };
        </script>
        {% set pageTitle = title or metadata.title %}
        {% set pageDescription = description or metadata.description %}
        {% set pageImage = metaImage or metadata.image %}
        {% set pageAbsoluteUrl = metadata.url ~ page.url %}
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
        <title>{{ pageTitle }}</title>
        <meta name="description" content="{{ pageDescription }}">
        <meta name="url" content="{{ pageAbsoluteUrl }}"/>
        <meta name="author" content="Duo Studio">
        <meta property="og:type" content="business.business"/>
        <meta property="og:title" content="{{ pageTitle }}"/>
        <meta property="og:site_name" content="Duo Studio"/>
        <meta property="og:url" content="{{ pageAbsoluteUrl }}"/>
        <meta property="og:description" content="{{ pageDescription }}"/>
        <meta property="og:image" content="{{ pageImage }}"/>
        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:creator" content="Duo Studio">
        <meta property="twitter:domain" content="duo-studio.co"/>
        <meta property="twitter:url" content="{{ pageAbsoluteUrl }}"/>
        <meta name="twitter:title" content="{{ pageTitle }}"/>
        <meta name="twitter:description" content="{{ pageDescription }}"/>
        <meta name="twitter:image" content="{{ pageImage }}"/>
        <meta name="robots" content="{{ robots or 'index, follow' }}"/>
        <link rel="canonical" href="{{ pageAbsoluteUrl }}"/>
        <link rel="icon" type="image/x-icon" href="/assets/favicon.ico"/>
        <link rel="shortcut icon" type="image/jpg" href="/assets/Duo_Favicon.jpg" sizes="any"/>
        <link rel="shortcut icon" type="image/jpg" href="/assets/Duo_Favicon@16x16.jpg" sizes="16x16"/>
        <link rel="shortcut icon" type="image/jpg" href="/assets/Duo_Favicon.jpg" sizes="32x32"/>
        <link rel="shortcut icon" type="image/jpg" href="/assets/Duo_Favicon@180x180.jpg" sizes="180x180"/>
        <link rel="shortcut icon" type="image/jpg" href="/assets/Duo_Favicon@192x192.jpg" sizes="192x192"/>
        <link rel="shortcut icon" type="image/jpg" href="/assets/Duo_Favicon@512x512.jpg" sizes="512x512"/>
        <link rel="stylesheet" href="{{ assets.styles.inline }}?v={% version %}"/>
        <link rel="stylesheet" href="{{ assets.styles.lenis }}?v={% version %}"/>
        <link rel="preload" href="{{ assets.styles.fonts }}?v={% version %}" as="style" onload='this.onload=null;this.rel="stylesheet"'/>
        <noscript><link rel="stylesheet" href="{{ assets.styles.fonts }}?v={% version %}"/></noscript>
        <link rel="preload" href="{{ assets.styles.main }}?v={% version %}" as="style" onload='this.onload=null;this.rel="stylesheet"'/>
        <noscript><link rel="stylesheet" href="{{ assets.styles.main }}?v={% version %}"/></noscript>
        <script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js" defer></script>
        <script src="https://unpkg.com/@barba/core" defer></script>
        <script src="/scripts/libs/gsap.min.js?v={% version %}" defer></script>
        <script src="/scripts/libs/lenis.min.js?v={% version %}" defer></script>
        <script src="/scripts/libs/ScrollTrigger.min.js?v={% version %}" defer></script>
        <script src="/scripts/libs/SplitText.min.js?v={% version %}" defer></script>
        <script src="{{ assets.scripts.tools }}?v={% version %}" defer></script>
        <script src="{{ assets.scripts.global }}?v={% version %}" defer></script>
        <script type="application/ld+json">{% structuredData page.url, pageTitle, pageDescription, pageImage %}</script>
    </head>
    <body data-barba="wrapper">
        <div class="cursor">
            <span></span>
        </div>
        {% include "layouts/header.njk" %}
        {{ content | safe }}
        <div class="page-transition"></div>
        <aside class="duo-consent" data-analytics-consent hidden aria-label="Analytics preferences">
            <p>
                We use analytics to understand how the site performs.
                <a href="/privacy-policy/">Privacy policy</a>
            </p>
            <div class="duo-consent__actions">
                <button type="button" data-analytics-consent-choice="denied">Reject</button>
                <button type="button" data-analytics-consent-choice="granted">Allow analytics</button>
            </div>
        </aside>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var banner = document.querySelector("[data-analytics-consent]");
                if (!banner || !window.__duoAnalyticsProductionHost) {
                    return;
                }

                banner.querySelectorAll("[data-analytics-consent-choice]").forEach(function (button) {
                    button.addEventListener("click", function () {
                        window.duoSetAnalyticsConsent(button.dataset.analyticsConsentChoice);
                    });
                });

                if (!window.__duoAnalyticsConsent) {
                    banner.hidden = false;
                }
            });
        </script>
    </body>
</html>
