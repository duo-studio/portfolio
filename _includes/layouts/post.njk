---
eleventyComputed:
    title: "{{ headline }}" 
layout: layouts/base.njk
---

{% set postDisplayHeadline = displayHeadline or headline %}

<div class="barba-container loading" data-barba="container" data-barba-namespace="journal">
    <main>
        <section id="post" class="entry">
            <div class="section__wrapper">
                <div class="entry__thumbnail">
                    {% if featImage %}
                        {% set img = featImage %}
                        {% image img, "featured-image" %}
                    {% endif %}
                    {% if imageCaption %}
                        <p class="subtitle">{{ imageCaption }}</p>
                    {% endif %}
                </div>
                {% if archiveHref and archiveLabel %}
                    <a href="{{ archiveHref }}" class="entry__back cursor__hover --highlight" aria-label="{{ archiveLabel }}">
                        <svg class="entry__back-icon" viewBox="0 0 34 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                            <path d="M32 8H4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            <path d="M8.5 3L3 8L8.5 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                {% endif %}
                <h1 class="entry__headline title-2 headline__load">{{ postDisplayHeadline }}</h1>
                <ul class="entry__metadata">
                    <div class="st__line"></div>
                    {% if author %}
                        <li class="subtitle entry__metadata--author">
                            Entry from: {{ author }}
                        </li>
                    {% endif %}
                    <li class="entry__metadata--date">
                        <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
                    </li>
                    {% if category %}
                        <li class="btn__small entry__metadata--btn --tag">
                            {{ category }}
                        </li>
                    {% endif %}
                </ul>
                <div class="entry__content">
                    {{ content | safe }}
                    <div class="entry__content--share">
                        <p class="subtitle">Share:</p>
                        <div class="entry__content--share-links">
                            <a
                                href="https://www.facebook.com/sharer/sharer.php?u={{ metadata.url+page.url }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn__small --tag cursor__hover --highlight">Facebook</a>
                            <a
                                href="https://www.linkedin.com/sharing/share-offsite/?url={{ metadata.url+page.url }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn__small --tag cursor__hover --highlight">LinkedIn</a>
                            <a
                                href="mailto:?subject={{ headline | urlencode }}&body=Check out this article from Duo Studio: {{ metadata.url+page.url }}"
                                class="btn__small --tag cursor__hover --highlight">Email</a>
                            <a
                                href="#"
                                class="btn__small --tag cursor__hover --highlight"
                                onclick="navigator.clipboard.writeText('{{ metadata.url+page.url }}').then(function(){var el=event.target;el.textContent='Copied!';setTimeout(function(){el.textContent='Copy Link'},2000)});return false;">Copy Link</a>
                        </div>
                    </div>
                </div>
                {%- if category == "Guide" %}
                    <div class="entry__related">
                        <h2 class="st__headline">Recommended Guides</h2>
                        <div class="row" style="display: flex; justify-content: space-between; margin-top: 1.5rem; gap: 1.5rem;">
                            {% set guideCount = 0 %}
                            {% for item in collections.all | reverse %}
                                {% if item.data.category == "Guide" and item.url != page.url and guideCount < 3 %}
                                    {% set relatedGuideHeadline = item.data.displayHeadline or item.data.headline %}
                                    <a class="col cursor__hover --highlight" href="{{ item.data.permalink }}" style="width: calc(33.333% - 1rem);">
                                        {% if item.data.featImage %}
                                            {% set guideSlug = item.url | replace("/guides/", "") | replace("/", "") %}
                                            {% set guideThumb = item.data.featImage | replace("./", "../" + guideSlug + "/") %}
                                            <div class="no-overflow">
                                                <div class="entry__related--thumbnail">
                                                    {% image guideThumb, relatedGuideHeadline %}
                                                </div>
                                            </div>
                                        {% endif %}
                                        <h3>{{ relatedGuideHeadline }}</h3>
                                    </a>
                                    {% set guideCount = guideCount + 1 %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {%- if collections.posts and tags and "posts" in tags %}
                    {%- set postslist = collections.posts -%}
                    <div class="entry__related">
                        <h2 class="st__headline">Recent Entries</h2>
                        <div class="row">
                            {% set count = 0 %}
                            {% for post in postslist | reverse %}
                                {% if page.url != post.url %}
                                    {% if count < 2 %}
                                        {% set relatedPostHeadline = post.data.displayHeadline or post.data.headline %}
                                        <a class="col cursor__hover --highlight" href="{% if post.data.externalLink %}{{ post.data.externalLink }}{% else %}{{ post.data.permalink }}{% endif %}" target="{% if post.data.externalLink %}_blank{% else %}_self{% endif %}">
                                            {% set relatedThumb = "../"+post.data.permalink+post.data.featImage %}
                                            <div class="no-overflow">
                                                <div class="entry__related--thumbnail">
                                                    {% image relatedThumb, "featured-image" %}
                                                </div>
                                            </div>
                                            <h3>{{ relatedPostHeadline }}</h3>
                                        </a>
                                    {% endif %}
                                    {% set count = count + 1 %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>
        {% include "layouts/footer.njk" %}
    </main>
</div>
