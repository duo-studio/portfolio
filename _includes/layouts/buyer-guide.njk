---
eleventyComputed:
    title: "{{ headline }}"
layout: layouts/base.njk
---
{% from "partials/guides/modules.njk" import answer, rows, proof, checklist, faq, related, inquiry %}
{% set guide = buyerGuides[guideKey] %}
<div class="barba-container loading" data-barba="container" data-barba-namespace="journal">
    <main class="buyer-guide">
        <article>
            <section class="buyer-guide__hero" aria-labelledby="guide-title">
                <div class="buyer-guide__eyebrow">
                    <a href="/guides/" class="buyer-guide__back">← All guides</a>
                    <span>{{ guide.topic }}</span>
                </div>
                <h1 class="headline__load" id="guide-title">{{ displayHeadline or headline }}</h1>
                <div class="buyer-guide__intro">
                    <p class="buyer-guide__credit">By {{ author }}<br>Updated <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time></p>
                    <p class="buyer-guide__dek">{{ guide.intro }}</p>
                </div>
                <div class="buyer-guide__contents" role="navigation" aria-label="In this guide">
                    <span>In this guide</span>
                    {% for item in guide.contents %}<a href="#{{ item.id }}">{{ item.label }} <span aria-hidden="true">↘</span></a>{% endfor %}
                </div>
            </section>
            {{ answer(guide.answer) }}
            {% for section in guide.sections %}
                {% if section.type == "rows" %}{{ rows(section) }}
                {% elif section.type == "proof" %}{{ proof(section) }}
                {% elif section.type == "checklist" %}{{ checklist(section) }}{% endif %}
            {% endfor %}
            {{ faq(guide.faqs) }}
            {{ inquiry(guide.cta) }}
            {{ related(guide.related) }}
            <script type="application/ld+json">{{ guide.faqSchema | safe }}</script>
        </article>
        {% include "layouts/footer.njk" %}
    </main>
</div>
