---
layout: layouts/post.njk
---
{# Shared content modules inside the existing guide layout, not a separate design. #}
{% from "partials/guides/modules.njk" import answer, rows, proof, checklist, faq, related, inquiry %}
{% set guide = buyerGuides[guideKey] %}
<div class="entry__content--sidebar">
    <h2 class="title-3 entry__content--sidebar-excerpt">{{ guide.intro }}</h2>
    <div class="entry__content--sidebar-toc">
        <h3>Table of Contents:</h3>
        <ul>
            <li><a href="#quick-answer">Quick answer</a></li>
            {% for section in guide.sections %}<li><a href="#{{ section.id }}">{{ section.title }}</a></li>{% endfor %}
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#lets-talk">Let's talk</a></li>
        </ul>
    </div>
</div>
<div class="entry__content--main">
    {{ answer(guide.answer) }}
    {% for section in guide.sections %}
        {% if section.type == "rows" %}{{ rows(section) }}
        {% elif section.type == "proof" %}{{ proof(section) }}
        {% elif section.type == "checklist" %}{{ checklist(section) }}{% endif %}
    {% endfor %}
    {{ faq(guide.faqs) }}
    {{ inquiry(guide.cta) }}
    {{ related(guide.related) }}
</div>
<script type="application/ld+json">{{ guide.faqSchema | safe }}</script>
