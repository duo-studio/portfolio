{% macro answer(data) %}
<section class="buyer-guide__answer buyer-guide__section" id="quick-answer" aria-labelledby="answer-title">
    <p class="buyer-guide__label">The short answer</p>
    <div><h2 id="answer-title">{{ data.title }}</h2><p>{{ data.body }}</p></div>
</section>
{% endmacro %}

{% macro rows(data) %}
<section class="buyer-guide__section" id="{{ data.id }}" aria-labelledby="{{ data.id }}-title">
    <p class="buyer-guide__label">{{ data.label }}</p>
    <div class="buyer-guide__body">
        <h2 id="{{ data.id }}-title">{{ data.title }}</h2>
        {% if data.intro %}<p class="buyer-guide__section-intro">{{ data.intro }}</p>{% endif %}
        <ol class="buyer-guide__rows">
            {% for item in data.items %}
            <li><span class="buyer-guide__number" aria-hidden="true">0{{ loop.index }}</span><div><h3>{{ item.title }}</h3><p>{{ item.body }}</p>{% if item.note %}<p class="buyer-guide__row-note">{{ item.note }}</p>{% endif %}</div></li>
            {% endfor %}
        </ol>
        {% if data.link %}<a class="buyer-guide__text-link" href="{{ data.link.href }}">{{ data.link.label }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
</section>
{% endmacro %}

{% macro proof(data) %}
<section class="buyer-guide__proof" id="{{ data.id }}" aria-labelledby="{{ data.id }}-title">
    <div class="buyer-guide__proof-heading"><p class="buyer-guide__label">From our work</p><h2 id="{{ data.id }}-title">{{ data.title }}</h2></div>
    <div class="buyer-guide__projects">
        {% for project in data.projects %}
        <a class="buyer-guide__project" href="{{ project.href }}">
            <img src="{{ project.image }}" alt="{{ project.alt }}" width="1024" height="680" loading="lazy" decoding="async">
            <div class="buyer-guide__project-heading"><h3>{{ project.name }}</h3><span aria-hidden="true">↗</span></div>
            <p class="buyer-guide__project-scope">{{ project.scope }}</p>
            <p>{{ project.body }}</p>
            <span class="buyer-guide__text-link">View project</span>
        </a>
        {% endfor %}
    </div>
</section>
{% endmacro %}

{% macro checklist(data) %}
<section class="buyer-guide__section buyer-guide__checklist" id="{{ data.id }}" aria-labelledby="{{ data.id }}-title">
    <p class="buyer-guide__label">{{ data.label }}</p>
    <div><h2 id="{{ data.id }}-title">{{ data.title }}</h2>{% if data.intro %}<p class="buyer-guide__section-intro">{{ data.intro }}</p>{% endif %}
        <ul>{% for item in data.items %}<li><span aria-hidden="true">↗</span><p>{{ item }}</p></li>{% endfor %}</ul>
        {% if data.note %}<p class="buyer-guide__note">{{ data.note }}</p>{% endif %}
    </div>
</section>
{% endmacro %}

{% macro faq(items) %}
<section class="buyer-guide__section buyer-guide__faq" id="faq" aria-labelledby="faq-title">
    <p class="buyer-guide__label">A few more answers</p>
    <div><h2 id="faq-title">Good questions.</h2>
        {% for item in items %}<details><summary>{{ item.question }}<span aria-hidden="true">+</span></summary><p>{{ item.answer }}</p></details>{% endfor %}
    </div>
</section>
{% endmacro %}

{% macro inquiry(data) %}
<section class="buyer-guide__section buyer-guide__inquiry" id="lets-talk" aria-labelledby="inquiry-title">
    <p class="buyer-guide__label">Your next chapter</p>
    <div><h2 id="inquiry-title">{{ data.title }}</h2><p>{{ data.body }}</p><a class="buyer-guide__button" href="/contact/">{{ data.label }} <span aria-hidden="true">↗</span></a></div>
</section>
{% endmacro %}

{% macro related(items) %}
<div class="buyer-guide__related" role="navigation" aria-label="Related reading">
    <p class="buyer-guide__label">Keep exploring</p>
    <div>{% for item in items %}<a href="{{ item.href }}">{{ item.label }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>
</div>
{% endmacro %}
