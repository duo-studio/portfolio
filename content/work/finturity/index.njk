                    <div class="inner">
                        <div class="col st__text">
                            <span>Our Objective</span>
                        </div>
                        <div class="col st__text">
                            <h3>
                                Finturity is a financial advising company providing personalized retirement plans for organizations and nonprofits. From
                                brand naming and identity design to website design and content creation, we established an all-encompassing brand
                                experience that inspires people to save for a better future.
                            </h3>
                        </div>
                    </div>
                    <a class="btn__circle light" href="https://www.finturity.com/" target="_blank" rel="noopener noreferrer">
                        <p>View Website</p>
                    </a>
                </div>
            </div>
