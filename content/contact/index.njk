---
layout: layouts/base.njk
eleventyComputed:
    title: Contact | {{ metadata.title }}
description: Contact Duo Studio for brand identity, web design, and graphic design services. Based in Baltimore and DC, serving clients nationwide. Call (410) 449-0366 or email hello@duo-studio.co.
---

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Duo Studio",
    "description": "Contact Duo Studio for brand identity, web design, and graphic design services. Based in Baltimore and DC, serving clients nationwide.",
    "mainEntity": {
        "@type": "LocalBusiness",
        "name": "Duo Studio",
        "description": "Digital design studio specializing in brand identity, web design, and graphic design for businesses that have outgrown their current brand.",
        "image": "https://duo-studio.co/assets/DuoStudio_Meta--v2.jpg",
        "url": "https://duo-studio.co",
        "telephone": "+1-410-449-0366",
        "email": "hello@duo-studio.co",
        "priceRange": "$$$",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Baltimore",
            "addressRegion": "MD",
            "addressCountry": "US"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": 39.2904,
            "longitude": -76.6122
        },
        "areaServed": [
            {
                "@type": "City",
                "name": "Baltimore"
            },
            {
                "@type": "City",
                "name": "Washington"
            },
            {
                "@type": "State",
                "name": "Maryland"
            },
            {
                "@type": "State",
                "name": "Virginia"
            },
            {
                "@type": "Country",
                "name": "United States"
            }
        ],
        "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "18:00"
        },
        "sameAs": [
            "https://www.instagram.com/duostudio_co/",
            "https://www.linkedin.com/company/duostudio/",
            "https://www.facebook.com/duostudioco/"
        ]
    }
}
</script>

<div class="barba-container loading" data-barba="container" data-barba-namespace="contact">
    <main>
        <section id="main">
            <div class="section__wrapper">
                <div class="row">
                    <div class="col">
                        <h1 class="headline__load lg">Tell us where<br>you’re headed</h1>
                        <div class="row__inner">
                            <div class="col__inner">
                                <p>Follow Us</p>
                                <p class="subtitle">
                                    <a href="https://www.instagram.com/duostudio_co/" target="_blank" rel="noopener noreferrer">Instagram</a>,
                                    <a href="https://www.linkedin.com/company/duostudio" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                                </p>
                            </div>
                            <div class="col__inner">
                                <p>Phone</p>
                                <p class="subtitle">
                                    <a href="tel:+14104490366">(410) 449-0366</a>
                                </p>
                            </div>
                            <div class="col__inner">
                                <p>General Inquiries</p>
                                <p class="subtitle">
                                    <a href="mailto:hello@duo-studio.co">hello@duo-studio.co</a>
                                </p>
                            </div>
                            <div class="col__inner">
                                <p>Main Hubs</p>
                                <p class="subtitle">Baltimore, DC</p>
                            </div>
                        </div>
                    </div>
                    <div class="col" id="form">
                        <div class="st__line"></div>
                        <form
                            method="POST"
                            name="contact"
                            action="/.netlify/functions/contact-lead"
                            netlify-honeypot="bot-field"
                            data-turnstile-required="{{ metadata.turnstileRequired }}"
                            data-contact-form>
                            <div class="wrapper">
                                <h2>Dear Duo Studio,</h2>
                                <div class="highlight"></div>
                            </div>
                            <textarea
                                type="text"
                                name="message"
                                id="message"
                                placeholder="Tell us about your company and how we can help"
                                required="required"></textarea>
                            <input type="text" placeholder="Name" name="name" id="name" required="required"/>
                            <input type="email" placeholder="Email" name="email" id="email" required="required"/>
                            <input type="text" placeholder="Company" name="company" id="company" required="required"/>
                            <select name="referrer" id="referrer">
                                <option value="" disabled selected>How did you hear about us?</option>
                                <option value="Google Search">Google Search</option>
                                <option value="Instagram">Instagram</option>
                                <option value="LinkedIn">LinkedIn</option>
                                <option value="Awwwards">Awwwards</option>
                                <option value="Clutch">Clutch</option>
                                <option value="Referral">Referral</option>
                                <option value="Other">Other</option>
                            </select>
                            <div class="contact-form__verification">
                                {% if metadata.turnstileSiteKey %}
                                <div data-turnstile-container data-sitekey="{{ metadata.turnstileSiteKey }}" data-theme="light" data-appearance="interaction-only"></div>
                                {% endif %}
                                <p class="contact-form__status" data-contact-form-status hidden aria-live="polite"></p>
                            </div>
                            <input name="bot-field" type="hidden"/>
                            <input name="page" type="hidden" value="/contact/"/>
                            <input name="attribution_first_landing_page" type="hidden"/>
                            <input name="attribution_first_referrer" type="hidden"/>
                            <input name="attribution_first_visit_at" type="hidden"/>
                            <input name="attribution_current_page" type="hidden"/>
                            <input name="attribution_previous_page" type="hidden"/>
                            <input name="attribution_path_history" type="hidden"/>
                            <input name="attribution_first_utm_source" type="hidden"/>
                            <input name="attribution_first_utm_medium" type="hidden"/>
                            <input name="attribution_first_utm_campaign" type="hidden"/>
                            <input name="attribution_first_utm_content" type="hidden"/>
                            <input name="attribution_first_utm_term" type="hidden"/>
                            <input name="attribution_latest_utm_source" type="hidden"/>
                            <input name="attribution_latest_utm_medium" type="hidden"/>
                            <input name="attribution_latest_utm_campaign" type="hidden"/>
                            <input name="attribution_latest_utm_content" type="hidden"/>
                            <input name="attribution_latest_utm_term" type="hidden"/>
                            <input name="attribution_first_gclid" type="hidden"/>
                            <input name="attribution_latest_gclid" type="hidden"/>
                            <input name="attribution_first_fbclid" type="hidden"/>
                            <input name="attribution_latest_fbclid" type="hidden"/>
                            <button class="btn__circle" type="submit" data-contact-submit-button aria-live="polite">
                                <div class="no-overflow">
                                    <div class="inner">
                                        <p>Send Message</p>
                                        <p>Sending...</p>
                                        <p>Message Sent!</p>
                                    </div>
                                </div>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>
